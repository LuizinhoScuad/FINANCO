# Financo — modelo de variáveis de ambiente
#
# Copie para .env e preencha. O .env NUNCA vai para o Git; este modelo vai,
# para que quem clonar o projeto saiba o que precisa configurar.
#
# Os valores abaixo são exemplos. Os reais ficam no console do Firebase,
# em Configurações do projeto.

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Firebase, lado do navegador -------------------------------------------
# Podem aparecer no código do cliente: não são segredo. Quem protege os dados
# são as regras (firestore.rules / storage.rules), não estas chaves.

NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="SEU-PROJETO.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="SEU-PROJETO"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="SEU-PROJETO.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase, lado do servidor (Admin SDK) --------------------------------
# ⚠️ ISTO É SEGREDO DE VERDADE. Quem tem a chave privada acessa todos os dados
# de todos os usuários, ignorando as regras de segurança. Nunca versione,
# nunca cole em conversa, nunca envie por e-mail.
#
# Em produção (Firebase App Hosting) estas duas não são necessárias: o próprio
# ambiente fornece a credencial. Só valem para rodar na sua máquina.

FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@SEU-PROJETO.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
